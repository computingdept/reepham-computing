        {
          "type": "paragraph",
          "title": "Choose by purpose",
          "text": "Integer: whole number; real: fractional measurement; character: one symbol; string: sequence of characters; Boolean: True or False. An ID such as 0042 is a string when its leading zeros matter."
        },
        {
          "type": "paragraph",
          "title": "Read the bits",
          "text": "Unsigned 8-bit weights are 128, 64, 32, 16, 8, 4, 2, 1. Add weights containing a 1. For 00101101: 32 + 8 + 4 + 1 = 45."
        },
        {
          "type": "paragraph",
          "title": "Write the bits",
          "text": "74 = 64 + 8 + 2, so 74 is 01001010. Use eight digits, including leading zeros. Unsigned n-bit values range from 0 to 2ⁿ − 1."
        }
      ],
      "questions": [
        {
          "id": "l1",
          "kind": "choice",
          "prompt": "Which type represents whether a sensor is working?",
          "answer": "Boolean",
          "feedback": "This has two logical states.",
          "options": [
            "Character",
            "Boolean",
            "Real"
          ]
        },
        {
          "id": "l2",
          "kind": "number",
          "prompt": "How many distinct patterns can 8 bits represent?",
          "answer": "256",
          "feedback": "2⁸ = 256."
        },
        {
          "id": "l3",
          "kind": "number",
          "prompt": "What is the largest unsigned 8-bit value?",
          "answer": "255",
          "feedback": "2⁸ − 1 = 255."
        }
      ]
    },
